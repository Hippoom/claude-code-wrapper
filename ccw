#!/bin/zsh
# CCW — Claude Code Wrapper
#
# .ccw stores the selected key name (one line, e.g. "ds-foo").
# Provider files define endpoints and model-tier mappings. Any provider file
# <name>.sh can be selected with --<name> or --<name>:<key>.
#
# Usage:
#   First time:     ccw --provider ds:ds-foo         (saves "ds-foo")
#   Later:          ccw --ds                         (reads key from file)
#                   ccw --ds:ds-bar                  (switches key)
#   Model tier:     ccw --ds --model haiku
#   Other:          ccw --list / --which / --help

set -e

CCW_CLAUDE_BIN="${CCW_CLAUDE_BIN:-claude}"

# ── Config directory resolution ──────────────────────────────────────────
# Priority: $CCW_CONFIG_DIR > XDG default
if [[ -n "$CCW_CONFIG_DIR" ]]; then
  CONFIG_DIR="${CCW_CONFIG_DIR}"
else
  CONFIG_DIR="${XDG_CONFIG_HOME:-${HOME}/.config}/ccw"
fi
PROFILES_DIR="${CONFIG_DIR}/providers"
KEYS_DIR="${CONFIG_DIR}/keys"

# ── Help ───────────────────────────────────────────────────────────────
if [[ "$1" == "--help" || "$1" == "-h" ]]; then
  cat <<'EOF'
CCW (Claude Code Wrapper) — per-project launcher

Usage:
  First time:   ccw --provider ds:ds-foo           (saves key to .ccw)
  Later:        ccw --ds                           (reads key from .ccw)
  Switch key:   ccw --ds:ds-bar                    (switches key)
  Model tier:   ccw --ds --model haiku|sonnet|opus
  Compatibility: ccw --ds --simple                 (custom-provider fallback)
  Other:         ccw --list | --which | --help

Provider shortcuts are generated from provider files:
  --<provider>  --<provider>:<key>

All remaining arguments, including --model, are passed to Claude Code.

Local Skills, plugins, hooks, and other Claude Code customizations load by
default. For a custom-provider compatibility fallback:
  --simple                   Set CLAUDE_CODE_SIMPLE=1
  CCW_SIMPLE=1               Same opt-in via environment variable

Simple mode is a reduced-initialization fallback that can suppress local
customizations, including Skills. The wrapper consumes --simple and does not
forward it to Claude Code. Full Skills load by default; --full-skills has been
removed, and the old CCLAUDE_FULL_SKILLS setting is not supported.

Config directory:
  $CCW_CONFIG_DIR/providers/       # optional override
  ~/.config/ccw/providers/         # XDG default

Key directory:
  <config>/keys/

All other args are passed through to claude.
EOF
  return 0 2>/dev/null || exit 0
fi

# ── List profiles & keys ───────────────────────────────────────────────
if [[ "$1" == "--list" ]]; then
  echo "Providers:"
  for pf in "${PROFILES_DIR}"/*.sh(N); do
    local pname="${pf:t:r}"
    local pdesc=""
    read -r pdesc < "$pf" 2>/dev/null || true
    if [[ "$pdesc" == "#"* ]]; then
      pdesc=" — ${pdesc#\# }"
    fi
    printf "  %-20s%s\n" "$pname" "$pdesc"
  done
  echo ""
  echo "Keys:"
  for kf in "${KEYS_DIR}"/*.sh(N); do
    local kname="${kf:t:r}"
    local kdesc=""
    read -r kdesc < "$kf" 2>/dev/null || true
    printf "  %-20s — %s\n" "$kname" "${kdesc#\# }"
  done
  return 0 2>/dev/null || exit 0
fi

# ── Parse provider ─────────────────────────────────────────────────────
PROVIDER=""
KEYNAME=""
SAVE_KEY=0
PROVIDER_ARG_CONSUMED=0

# --provider ds:ds-foo  (full explicit, saves key)
if [[ "$1" == "--provider" ]]; then
  if [[ -z "$2" ]]; then
    echo "ccw: --provider requires <provider>:<key>" >&2
    echo "  e.g. ccw --provider ds:ds-default" >&2
    return 1 2>/dev/null || exit 1
  fi
  SPEC="$2"
  if [[ "$SPEC" != *:* ]]; then
    echo "ccw: Invalid format: '${SPEC}'" >&2
    echo "  Expected: provider:keyname  (e.g. ds:ds-default)" >&2
    return 1 2>/dev/null || exit 1
  fi
  PROVIDER="${SPEC%%:*}"
  KEYNAME="${SPEC##*:}"
  if [[ -z "$PROVIDER" || -z "$KEYNAME" ]]; then
    echo "ccw: Invalid format: '${SPEC}'" >&2
    return 1 2>/dev/null || exit 1
  fi
  SAVE_KEY=1
  shift 2
  PROVIDER_ARG_CONSUMED=1
fi

# --<provider> / --<provider>:<key> (dynamic shortcuts from provider files)
if [[ "$PROVIDER_ARG_CONSUMED" -eq 0 && "$1" == --* ]]; then
  SHORTCUT="${1#--}"
  if [[ "$SHORTCUT" == *:* ]]; then
    CANDIDATE_PROVIDER="${SHORTCUT%%:*}"
    CANDIDATE_KEY="${SHORTCUT#*:}"
  else
    CANDIDATE_PROVIDER="$SHORTCUT"
    CANDIDATE_KEY=""
  fi

  if [[ -n "$CANDIDATE_PROVIDER" && -f "${PROFILES_DIR}/${CANDIDATE_PROVIDER}.sh" ]]; then
    if [[ "$SHORTCUT" == *:* && -z "$CANDIDATE_KEY" ]]; then
      echo "ccw: Key name cannot be empty in '${1}'" >&2
      return 1 2>/dev/null || exit 1
    fi
    PROVIDER="$CANDIDATE_PROVIDER"
    if [[ -n "$CANDIDATE_KEY" ]]; then
      KEYNAME="$CANDIDATE_KEY"
      SAVE_KEY=1
    fi
    shift
    PROVIDER_ARG_CONSUMED=1
  fi
fi

# ── Parse wrapper-only options ─────────────────────────────────────────
# Full Claude Code initialization—including local Skills—is the default.
# --simple is an explicit custom-provider compatibility fallback. Consume it
# before forwarding the remaining arguments to Claude Code.
SIMPLE_MODE="${CCW_SIMPLE:-0}"
if [[ "$#" -gt 0 ]]; then
  local -a CLAUDE_ARGS=()
  for arg in "$@"; do
    case "$arg" in
      --simple)
        SIMPLE_MODE=1
        ;;
      --full-skills)
        echo "ccw: --full-skills has been removed; full Skills already load by default." >&2
        return 2 2>/dev/null || exit 2
        ;;
      *)
        CLAUDE_ARGS+=("$arg")
        ;;
    esac
  done
  set -- "${CLAUDE_ARGS[@]}"
fi

# ── Resolve key from file ──────────────────────────────────────────────
if [[ -z "$KEYNAME" ]]; then
  local dir="$PWD"
  while true; do
    if [[ -f "${dir}/.ccw" ]]; then
      while IFS= read -r line; do
        line="${line%%#*}"
        line="${line## }"
        line="${line%% }"
        if [[ -n "$line" ]]; then
          KEYNAME="$line"
          break
        fi
      done < "${dir}/.ccw"
      if [[ -n "$KEYNAME" ]]; then
        break
      fi
    fi
    if [[ "$dir" == "/" ]]; then
      break
    fi
    dir="${dir:h}"
  done
fi

# ── Which mode (resolve early so we can show partial info) ─────────────
if [[ "$1" == "--which" ]]; then
  WHICH_MODE=1
  shift
fi

# If --which and no provider: show what we know, don't error
if [[ -n "$WHICH_MODE" && -z "$PROVIDER" ]]; then
  if [[ -n "$KEYNAME" ]]; then
    echo "Key:      ${KEYNAME}  (from .ccw)"
    echo "Provider: <not specified>"
    echo ""
    echo "Specify a provider to see the full resolved config:"
    echo "  ccw --ds --which"
    echo "  ccw --gpt --which"
  else
    echo "Key:      <not configured>"
    echo "Provider: <not specified>"
    echo ""
    echo "No .ccw found. Set up this project first:"
    echo "  ccw --provider ds:<keyname>"
    echo "  Available keys: ccw --list"
  fi
  return 0 2>/dev/null || exit 0
fi

# Must have a provider (for launch or full --which)
if [[ -z "$PROVIDER" ]]; then
  echo "ccw: Must specify a provider." >&2
  echo "  Shortcuts:  --<provider>  (run --list to see available providers)" >&2
  echo "  Full:       --provider ds:ds-default" >&2
  return 1 2>/dev/null || exit 1
fi

# Must have a key
if [[ -z "$KEYNAME" ]]; then
  echo "ccw: No key found." >&2
  echo "  Specify one:  ccw --provider ${PROVIDER}:<keyname>" >&2
  echo "  Or:           ccw --${PROVIDER}:<keyname>" >&2
  echo "  Available:    ccw --list" >&2
  return 1 2>/dev/null || exit 1
fi

# ── Save key if explicitly specified ───────────────────────────────────
if [[ "$SAVE_KEY" -eq 1 ]]; then
  echo "${KEYNAME}" > "${PWD}/.ccw"
  chmod 644 "${PWD}/.ccw" 2>/dev/null || true
fi

# ── Validate files ─────────────────────────────────────────────────────
PROFILE_FILE="${PROFILES_DIR}/${PROVIDER}.sh"
if [[ ! -f "$PROFILE_FILE" ]]; then
  echo "ccw: Provider '${PROVIDER}' not found at ${PROFILE_FILE}" >&2
  echo "  Use --list to see available providers" >&2
  return 1 2>/dev/null || exit 1
fi

KEY_FILE="${KEYS_DIR}/${KEYNAME}.sh"
if [[ ! -f "$KEY_FILE" ]]; then
  echo "ccw: Key '${KEYNAME}' not found at ${KEY_FILE}" >&2
  echo "  Use --list to see available keys" >&2
  return 1 2>/dev/null || exit 1
fi

# ── Clear old env, load new ────────────────────────────────────────────
unset ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN ANTHROPIC_BASE_URL \
      ANTHROPIC_MODEL ANTHROPIC_SMALL_FAST_MODEL \
      ANTHROPIC_DEFAULT_OPUS_MODEL ANTHROPIC_DEFAULT_SONNET_MODEL \
      ANTHROPIC_DEFAULT_HAIKU_MODEL ANTHROPIC_REASONING_MODEL

# Warn if config files are world-readable (potential secret exposure)
if [[ -n "$(find "$PROFILE_FILE" "$KEY_FILE" -perm /o+r 2>/dev/null)" ]]; then
  echo "ccw: Warning — config files are world-readable:" >&2
  ls -la "$PROFILE_FILE" "$KEY_FILE" 2>/dev/null | sed 's/^/  /' >&2
  echo "  Consider: chmod 600 $PROFILE_FILE $KEY_FILE" >&2
fi

source "$PROFILE_FILE"
source "$KEY_FILE"

# ── Auto-detect --bare requirement ──────────────────────────────────────
# Non-Anthropic providers need --bare to skip OAuth login flow.
# Detect this by checking if ANTHROPIC_BASE_URL points away from Anthropic.
NEED_BARE=0
if [[ -n "$ANTHROPIC_BASE_URL" ]]; then
  case "$ANTHROPIC_BASE_URL" in
    https://api.anthropic.com|https://api.anthropic.com/*)
      # Official Anthropic endpoint — no --bare needed
      ;;
    *)
      NEED_BARE=1
      ;;
  esac
fi

# ── Which mode output ──────────────────────────────────────────────────
if [[ -n "$WHICH_MODE" ]]; then
  echo "Provider: ${PROVIDER}  → ${PROFILE_FILE}"
  echo "Key:      ${KEYNAME}  → ${KEY_FILE}"
  echo ""
  echo "Env vars:"
  for var in ANTHROPIC_BASE_URL ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN \
             ANTHROPIC_MODEL ANTHROPIC_DEFAULT_OPUS_MODEL \
             ANTHROPIC_DEFAULT_SONNET_MODEL ANTHROPIC_DEFAULT_HAIKU_MODEL \
             ANTHROPIC_REASONING_MODEL; do
    if [[ -n "${(P)var}" ]]; then
      printf "  %-35s = " "$var"
      if [[ "$var" == *"TOKEN"* || "$var" == *"KEY"* ]]; then
        echo "${(P)var:0:12}..."
      else
        echo "${(P)var}"
      fi
    fi
  done
  if [[ "$NEED_BARE" -eq 1 ]]; then
    echo ""
    if [[ "$SIMPLE_MODE" == "1" ]]; then
      echo "Note: Custom-provider compatibility mode enabled — CLAUDE_CODE_SIMPLE=1."
      echo "      Local Skills and other customizations may be unavailable."
    else
      echo "Note: Full Claude Code initialization enabled, including local Skills."
      echo "      Use --simple or CCW_SIMPLE=1 for the compatibility fallback."
    fi
  fi
  return 0 2>/dev/null || exit 0
fi

# ── Launch ─────────────────────────────────────────────────────────────
if [[ "$SIMPLE_MODE" == "1" ]]; then
  # Explicit fallback for custom providers that require reduced initialization.
  export CLAUDE_CODE_SIMPLE=1
else
  # Do not inherit simple mode from a parent Claude Code process: the default
  # must load the caller's complete local Claude Code environment and Skills.
  unset CLAUDE_CODE_SIMPLE
fi

exec "$CCW_CLAUDE_BIN" "$@"
